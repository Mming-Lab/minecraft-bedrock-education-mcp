+// --- translation equivariance: f(center + d) == f(center) + d ---
+function equivarianceCheck(fn: string, at0: Position[], at100: Position[], dx: number, dy: number, dz: number): void {
+  checked++;
+  if (at0.length !== at100.length) {
+    violations.push({ fn, args: 'translation', kind: 'NOT_EQUIVARIANT', detail: `count differs: ${at0.length} vs ${at100.length}` });
+    return;
+  }
+  const shifted: { [k: string]: boolean } = {};
+  for (const p of at0) shifted[`${p.getValue(Axis.X) + dx},${p.getValue(Axis.Y) + dy},${p.getValue(Axis.Z) + dz}`] = true;
+  let missing = 0;
+  for (const p of at100) if (!shifted[key(p)]) missing++;
