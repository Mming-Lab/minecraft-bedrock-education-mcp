+// Second round of geometry fixes. Same all-or-nothing anchoring as apply-fixes.mjs.
+import fs from 'node:fs';
+
+const CRLF = '\r\n';
+const LF = '\n';
+const FILE = new URL('../src/coordinates.ts', import.meta.url);
+const raw = fs.readFileSync(FILE, 'utf8');
+const usedCrlf = raw.indexOf(CRLF) !== -1;
+let src = raw.split(CRLF).join(LF);
+
+function replaceOnce(label, find, replace) {
+  const count = src.split(find).length - 1;
+  if (count !== 1) throw new Error(`[${label}] anchor matched ${count} times, expected exactly 1`);
+  src = src.replace(find, replace);
+  console.log(`  applied: ${label}`);
+}
+
+// --- Fix F: midpoint circle stepped x down one iteration too early --------------------
+// The two independent `if` branches decide on `err` before and after it is updated, which
+// drops x a step early. At r = 10 that put (8,4) on the ring at distance 8.944 instead of
+// the correct (9,4) at 9.849 - over a block inside the intended radius.
+// This is the textbook form: advance y, update the error, then decide about x.
+replaceOnce(
+  'F: midpoint circle error stepping',
+  `                if (err <= 0) {
+                    y += 1;
+                    err += 2 * y + 1;
+                }
+                if (err > 0) {
+                    x -= 1;
+                    err -= 2 * x + 1;
+                }`,
+  `                // 標準形の中点円: y を進め、誤差を更新してから x を判定する。
+                // 誤差の判定を更新前後で二度行うと x が 1 ステップ早く減り、
+                // 半径から 1 ブロック以上ずれた点が出る。
+                y += 1;
+                err += 1 + 2 * y;
+                if (2 * (err - x) + 1 > 0) {
+                    x -= 1;
+                    err += 1 - 2 * x;
+                }`
+);
+
+// --- Fix G: baseRadius did not produce the base radius --------------------------------
+// With b = baseRadius - waistRadius the profile r(t) = sqrt(a^2 + (t*b)^2) reaches
+// sqrt(a^2 + b^2) at the ends, not baseRadius. base=6 waist=3 gave a maximum radius of 4
+// and a nearly cylindrical shape. Solving sqrt(a^2 + b^2) = baseRadius for b makes the
+// parameter mean what its name says.
+replaceOnce(
+  'G: hyperboloid base radius parameterisation',
+  `        // 双曲面の形状パラメータ
+        const a = waistRadiusInt; // 最小半径
+        const b = baseRadiusInt - waistRadiusInt; // 半径の変化幅`,
+  `        // 双曲面の形状パラメータ
+        const a = waistRadiusInt; // 最小半径（t = 0 での半径）
+        // 端 (t = ±1) の半径が baseRadius と一致するよう b を決める。
+        // r(t) = sqrt(a² + (t*b)²) なので sqrt(a² + b²) = baseRadius を b について解く。
+        // baseRadius が waistRadius 以下の形状はこの式では表せないため円柱に落とす。
+        const b = baseRadiusInt > waistRadiusInt
+            ? Math.sqrt(baseRadiusInt * baseRadiusInt - waistRadiusInt * waistRadiusInt)
+            : 0;`
+);
+
+fs.writeFileSync(FILE, usedCrlf ? src.split(LF).join(CRLF) : src, 'utf8');
+console.log('\nsrc/coordinates.ts updated');
