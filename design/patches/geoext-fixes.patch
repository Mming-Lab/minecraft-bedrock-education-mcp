@@ -0,0 +1,144 @@
+// Applies the geometry fixes to src/coordinates.ts. Each replacement asserts that its
+// anchor text is present exactly once, so a silent no-op is impossible.
+
+import fs from 'node:fs';
+
+const FILE = new URL('../src/coordinates.ts', import.meta.url);
+const CRLF = '\r\n';
+const LF = '\n';
+
+const raw = fs.readFileSync(FILE, 'utf8');
+// The file is stored with CRLF; normalise so the anchors below can be written with LF.
+const usedCrlf = raw.indexOf(CRLF) !== -1;
+let src = raw.split(CRLF).join(LF);
+
+function replaceOnce(label, find, replace) {
+  const count = src.split(find).length - 1;
+  if (count !== 1) {
+    throw new Error(`[${label}] anchor matched ${count} times, expected exactly 1`);
+  }
+  src = src.replace(find, replace);
+  console.log(`  applied: ${label}`);
+}
+
+// --- Fix A: hollow circle emitted every 8-way reflection unconditionally ---------------
+// On the axes (y === 0) and on the diagonal (x === y) several reflections land on the same
+// coordinate, so every hollow circle contained duplicates (50% at r=1, 7.1% at r=10).
+replaceOnce(
+  'A: hollow circle 8-way symmetry duplicates',
+  `                // 8方向の対称点を追加
+                positions.push(toWorld(x, y));
+                positions.push(toWorld(y, x));
+                positions.push(toWorld(-y, x));
+                positions.push(toWorld(-x, y));
+                positions.push(toWorld(-x, -y));
+                positions.push(toWorld(-y, -x));
+                positions.push(toWorld(y, -x));
+                positions.push(toWorld(x, -y));`,
+  `                // 8方向の対称点を追加。
+                // 軸上 (y === 0) と対角線上 (x === y) では反射像が元の点と重なるため、
+                // 重複を生まないよう条件付きで追加する。
+                positions.push(toWorld(x, y));
+                if (y !== 0) positions.push(toWorld(x, -y));
+                if (x !== 0) positions.push(toWorld(-x, y));
+                if (x !== 0 && y !== 0) positions.push(toWorld(-x, -y));
+
+                if (x !== y) {
+                    positions.push(toWorld(y, x));
+                    if (x !== 0) positions.push(toWorld(y, -x));
+                    if (y !== 0) positions.push(toWorld(-y, x));
+                    if (x !== 0 && y !== 0) positions.push(toWorld(-y, -x));
+                }`
+);
+
+// --- Fix B1: hyperboloid divided by the waist radius -----------------------------------
+// r(t) = a * sqrt(1 + (t*b/a)^2) is undefined at a = 0: the term becomes 0 * Infinity =
+// NaN, the loop bounds become NaN, and the function returns an empty array with no error.
+// sqrt(a^2 + (t*b)^2) is algebraically identical for a > 0 and well-defined at a = 0,
+// where it degenerates into the expected double cone.
+replaceOnce(
+  'B1: hyperboloid radius formula (removes division by waist radius)',
+  `            // 双曲面の方程式: r(t) = a * sqrt(1 + (t*b/a)²)
+            const currentRadius = a * Math.sqrt(1 + (t * b / a) * (t * b / a));`,
+  `            // 双曲面の方程式: r(t) = a * sqrt(1 + (t*b/a)²) = sqrt(a² + (t*b)²)
+            // 後者は a = 0（くびれ半径ゼロ）でも定義され、二重円錐に退化する。
+            const currentRadius = Math.sqrt(a * a + (t * b) * (t * b));`
+);
+
+// --- Fix B2: hyperboloid divided by halfHeight ----------------------------------------
+// height = 1 makes halfHeight 0, so t = 0 / 0 = NaN and the function returns empty.
+// A single-layer hyperboloid should sit at the waist, which t = 0 gives.
+replaceOnce(
+  'B2: hyperboloid halfHeight divisor (height = 1)',
+  `        for (let y = 0; y < heightInt; y++) {
+            // 中心からの距離 (-1 to 1 の範囲)
+            const t = (y - halfHeight) / halfHeight;`,
+  `        // height が 1 のとき halfHeight が 0 になり t が NaN になるのを防ぐ。
+        // 除数を 1 にすると単層は t = 0、すなわちくびれ位置に置かれる。
+        const halfHeightDivisor = halfHeight > 0 ? halfHeight : 1;
+
+        for (let y = 0; y < heightInt; y++) {
+            // 中心からの距離 (-1 to 1 の範囲)
+            const t = (y - halfHeight) / halfHeightDivisor;`
+);
+
+// --- Fix C: paraboloid divided by the height ------------------------------------------
+// focalLength = radiusSquared / (4 * heightInt) is Infinity at heightInt = 0, and
+// 4 * Infinity * 0 is NaN, so the function returned empty without reporting anything.
+// Substituting focalLength back in cancels the 4 and leaves a single division, which is
+// then guarded.
+replaceOnce(
+  'C: paraboloid focal length (removes intermediate Infinity)',
+  `        // パラボロイドの方程式: z = (x² + y²) / (4 * focal_length)
+        // focal_lengthを調整してheightに合わせる
+        const focalLength = radiusSquared / (4 * heightInt);
+
+        for (let y = 0; y < heightInt; y++) {
+            // 現在の高さでのパラボラ半径を計算
+            const currentRadiusSquared = 4 * focalLength * y;`,
+  `        // 高さが 1 未満では焦点距離が定義できない（0 除算で Infinity になる）。
+        if (heightInt < 1) {
+            return positions;
+        }
+
+        // パラボロイドの方程式: z = (x² + y²) / (4 * focal_length)
+        // focal_length = radiusSquared / (4 * heightInt) を代入すると 4 が相殺され、
+        // currentRadiusSquared = radiusSquared * y / heightInt となる。
+        // 中間値として Infinity を作らないぶん安全。
+        for (let y = 0; y < heightInt; y++) {
+            // 現在の高さでのパラボラ半径を計算
+            const currentRadiusSquared = (radiusSquared * y) / heightInt;`
+);
+
+// --- Fix D: low-precision PI ----------------------------------------------------------
+// 3.14159 is accurate to 6 digits. At the documented maximum radius of 200 the resulting
+// angular error moves a point by ~0.004 blocks, which rounding discards, so this was not
+// producing wrong output — but there is no reason not to use the exact value.
+replaceOnce(
+  'D: MATH_CONSTANTS uses Math.PI',
+  `    /** 数学定数 */
+    const MATH_CONSTANTS = {
+        PI: 3.14159,
+        TWO_PI: 2 * 3.14159
+    };`,
+  `    /** 数学定数 */
+    const MATH_CONSTANTS = {
+        PI: Math.PI,
+        TWO_PI: 2 * Math.PI
+    };`
+);
+
+// --- Fix E: helix step count could be zero ---------------------------------------------
+// radius = 0 and height = 0 together make helixLength 0, so steps is 0 and progress
+// becomes 0 / 0 = NaN. The coordinates are then rejected by validateCoordinates and the
+// result is silently empty. Clamping to at least one step keeps the degenerate case honest.
+replaceOnce(
+  'E: helix minimum step count',
+  `        const steps = Math.max(heightInt * 2, Math.round(helixLength)); // 連続性を保つ密度`,
+  `        // 半径と高さがともに 0 だと helixLength も 0 になり、progress が 0 / 0 = NaN になる。
+        // 最低 1 ステップを保証して NaN の伝播を防ぐ。
+        const steps = Math.max(1, Math.max(heightInt * 2, Math.round(helixLength))); // 連続性を保つ密度`
+);
+
+fs.writeFileSync(FILE, usedCrlf ? src.split(LF).join(CRLF) : src, 'utf8');
+console.log('\nsrc/coordinates.ts updated');
