index 0000000..c7223fa
--- /dev/null
+++ b/harness/run.ts
@@ -0,0 +1,394 @@
+// Runs every exported coordinate function over a parameter matrix and reports which
+// invariants each case violates. Detection only: no fixes are applied here.
+//
+//   npx tsc -p harness && node harness/built/harness/run.js
+
+const WORLD = { X_MIN: -30000000, X_MAX: 30000000, Y_MIN: -64, Y_MAX: 320, Z_MIN: -30000000, Z_MAX: 30000000 };
+
+interface Violation {
+  fn: string;
+  args: string;
+  kind: string;
+  detail: string;
+}
+
+const violations: Violation[] = [];
+let checked = 0;
+
+function key(p: Position): string {
+  return `${p.getValue(Axis.X)},${p.getValue(Axis.Y)},${p.getValue(Axis.Z)}`;
+}
+
+/**
+ * @param expectEmpty true when an empty result is the documented answer for this input,
+ *                    so "valid input produced nothing" is not reported.
+ */
+function check(fn: string, args: string, result: Position[], expectEmpty = false): void {
+  checked++;
+
+  if (!result) {
+    violations.push({ fn, args, kind: 'NULL', detail: 'returned null/undefined' });
+    return;
+  }
+
+  if (result.length === 0 && !expectEmpty) {
+    violations.push({ fn, args, kind: 'EMPTY', detail: 'valid input produced no positions' });
+    return;
+  }
+
+  let nonFinite = 0;
+  let nonInteger = 0;
+  let outOfBounds = 0;
+  const seen: { [k: string]: number } = {};
+  let duplicates = 0;
+  let firstBad = '';
+
+  for (const p of result) {
+    const x = p.getValue(Axis.X);
+    const y = p.getValue(Axis.Y);
+    const z = p.getValue(Axis.Z);
+
+    if (!isFinite(x) || !isFinite(y) || !isFinite(z)) {
+      nonFinite++;
+      if (!firstBad) firstBad = key(p);
+      continue;
+    }
+    if (x !== Math.floor(x) || y !== Math.floor(y) || z !== Math.floor(z)) {
+      nonInteger++;
+      if (!firstBad) firstBad = key(p);
+    }
+    if (
+      x < WORLD.X_MIN || x > WORLD.X_MAX ||
+      y < WORLD.Y_MIN || y > WORLD.Y_MAX ||
+      z < WORLD.Z_MIN || z > WORLD.Z_MAX
+    ) {
+      outOfBounds++;
+      if (!firstBad) firstBad = key(p);
+    }
+
+    const k = key(p);
+    seen[k] = (seen[k] || 0) + 1;
+    if (seen[k] === 2) duplicates++;
+  }
+
+  if (nonFinite) violations.push({ fn, args, kind: 'NaN/Inf', detail: `${nonFinite}/${result.length} non-finite, first ${firstBad}` });
+  if (nonInteger) violations.push({ fn, args, kind: 'NON_INTEGER', detail: `${nonInteger}/${result.length} non-integer, first ${firstBad}` });
+  if (outOfBounds) violations.push({ fn, args, kind: 'OUT_OF_BOUNDS', detail: `${outOfBounds}/${result.length} outside world bounds, first ${firstBad}` });
+  if (duplicates) {
+    const pct = ((duplicates / result.length) * 100).toFixed(1);
+    violations.push({ fn, args, kind: 'DUPLICATE', detail: `${duplicates} duplicated coords of ${result.length} (${pct}%)` });
+  }
+}
+
+function safe(fn: string, args: string, run: () => Position[], expectEmpty = false): void {
+  try {
+    check(fn, args, run(), expectEmpty);
+  } catch (error: any) {
+    violations.push({ fn, args, kind: 'THROW', detail: String(error && error.message ? error.message : error) });
+  }
+}
+
+const C = world(0, 0, 0);
+const c = coordinates;
+
+// --- sphere: density pinned to 1.0, since lower values sample with Math.random() ---
+for (const r of [1, 2, 5, 10]) {
+  safe('getSpherePositions', `r=${r}`, () => c.getSpherePositions(C, r, false, 1.0));
+  safe('getSpherePositions', `r=${r} hollow`, () => c.getSpherePositions(C, r, true, 1.0));
+}
+safe('getSpherePositions', 'r=2.5 (non-integer)', () => c.getSpherePositions(C, 2.5, false, 1.0));
+safe('getSpherePositions', 'r=0', () => c.getSpherePositions(C, 0, false, 1.0), true);
+safe('getSpherePositions', 'r=-1', () => c.getSpherePositions(C, -1, false, 1.0), true);
+
+// --- cuboid ---
+safe('getCuboidPositions', '0,0,0..3,3,3', () => c.getCuboidPositions(world(0, 0, 0), world(3, 3, 3)));
+safe('getCuboidPositions', 'hollow', () => c.getCuboidPositions(world(0, 0, 0), world(3, 3, 3), true));
+safe('getCuboidPositions', 'reversed corners', () => c.getCuboidPositions(world(3, 3, 3), world(0, 0, 0)));
+safe('getCuboidPositions', 'degenerate (same corner)', () => c.getCuboidPositions(world(0, 0, 0), world(0, 0, 0)));
+
+// --- cylinder / cone ---
+for (const [r, h] of [[3, 5], [1, 1], [5, 10]]) {
+  safe('getCylinderPositions', `r=${r} h=${h}`, () => c.getCylinderPositions(C, r, h));
+  safe('getCylinderPositions', `r=${r} h=${h} hollow`, () => c.getCylinderPositions(C, r, h, true));
+  safe('getConePositions', `r=${r} h=${h}`, () => c.getConePositions(C, r, h));
+  safe('getConePositions', `r=${r} h=${h} hollow`, () => c.getConePositions(C, r, h, true));
+}
+safe('getCylinderPositions', 'h=0', () => c.getCylinderPositions(C, 3, 0), true);
+safe('getConePositions', 'h=0', () => c.getConePositions(C, 3, 0), true);
+
+// --- torus ---
+for (const [R, r] of [[8, 3], [5, 2], [3, 1]]) {
+  safe('getTorusPositions', `R=${R} r=${r}`, () => c.getTorusPositions(C, R, r));
+  safe('getTorusPositions', `R=${R} r=${r} hollow`, () => c.getTorusPositions(C, R, r, true));
+}
+safe('getTorusPositions', 'R=3 r=0', () => c.getTorusPositions(C, 3, 0), true);
+safe('getTorusPositions', 'R=0 r=3', () => c.getTorusPositions(C, 0, 3));
+
+// --- ellipsoid ---
+safe('getEllipsoidPositions', '3,4,5', () => c.getEllipsoidPositions(C, 3, 4, 5));
+safe('getEllipsoidPositions', '3,4,5 hollow', () => c.getEllipsoidPositions(C, 3, 4, 5, true));
+safe('getEllipsoidPositions', 'rz=0', () => c.getEllipsoidPositions(C, 3, 3, 0), true);
+safe('getEllipsoidPositions', 'all 1', () => c.getEllipsoidPositions(C, 1, 1, 1));
+
+// --- line ---
+safe('getLinePositions', '(0,0,0)->(10,5,3)', () => c.getLinePositions(world(0, 0, 0), world(10, 5, 3)));
+safe('getLinePositions', 'same point', () => c.getLinePositions(world(0, 0, 0), world(0, 0, 0)));
+safe('getLinePositions', 'negative direction', () => c.getLinePositions(world(5, 5, 5), world(-5, -5, -5)));
+
+// --- helix ---
+for (const [r, h, t] of [[3, 10, 2], [5, 20, 4]]) {
+  safe('getHelixPositions', `r=${r} h=${h} turns=${t}`, () => c.getHelixPositions(C, r, h, t));
+}
+safe('getHelixPositions', 'radius=0', () => c.getHelixPositions(C, 0, 10, 3), true);
+safe('getHelixPositions', 'turns=0', () => c.getHelixPositions(C, 3, 10, 0), true);
+safe('getHelixPositions', 'height=0', () => c.getHelixPositions(C, 3, 0, 3), true);
+
+// --- paraboloid ---
+for (const [r, h] of [[5, 10], [3, 5]]) {
+  safe('getParaboloidPositions', `r=${r} h=${h}`, () => c.getParaboloidPositions(C, r, h));
+  safe('getParaboloidPositions', `r=${r} h=${h} hollow`, () => c.getParaboloidPositions(C, r, h, true));
+}
+safe('getParaboloidPositions', 'h=0', () => c.getParaboloidPositions(C, 5, 0), true);
+safe('getParaboloidPositions', 'h=1', () => c.getParaboloidPositions(C, 5, 1));
+safe('getParaboloidPositions', 'r=0', () => c.getParaboloidPositions(C, 0, 5), true);
+
+// --- hyperboloid ---
+safe('getHyperboloidPositions', 'base=5 waist=2 h=10', () => c.getHyperboloidPositions(C, 5, 2, 10));
+safe('getHyperboloidPositions', 'base=4 waist=4 h=5 (odd h)', () => c.getHyperboloidPositions(C, 4, 4, 5));
+safe('getHyperboloidPositions', 'h=0', () => c.getHyperboloidPositions(C, 5, 2, 0), true);
+safe('getHyperboloidPositions', 'waist=0', () => c.getHyperboloidPositions(C, 5, 0, 10));
+
+// --- circle ---
+for (const axis of [Axis.X, Axis.Y, Axis.Z]) {
+  safe('getCirclePositions', `r=5 axis=${axis}`, () => c.getCirclePositions(C, 5, axis));
+  safe('getCirclePositions', `r=5 axis=${axis} hollow`, () => c.getCirclePositions(C, 5, axis, true));
+}
+safe('getCirclePositions', 'r=0', () => c.getCirclePositions(C, 0, Axis.Y), true);
+
+// --- bezier ---
+safe('getVariableBezierCurvePositions', '1 control point', () =>
+  c.getVariableBezierCurvePositions(world(0, 0, 0), [world(5, 10, 0)], world(10, 0, 0)));
+safe('getVariableBezierCurvePositions', 'no control points', () =>
+  c.getVariableBezierCurvePositions(world(0, 0, 0), [], world(10, 0, 0)));
+safe('getVariableBezierCurvePositions', '30 control points (overflow probe)', () => {
+  const cps: Position[] = [];
+  for (let i = 0; i < 30; i++) cps.push(world(i, i % 5, 0));
+  return c.getVariableBezierCurvePositions(world(0, 0, 0), cps, world(40, 0, 0));
+});
+safe('getVariableBezierCurvePositions', '200 control points (overflow probe)', () => {
+  const cps: Position[] = [];
+  for (let i = 0; i < 200; i++) cps.push(world(i, i % 7, 0));
+  return c.getVariableBezierCurvePositions(world(0, 0, 0), cps, world(210, 0, 0));
+});
+
+// --- hollow containment: hollow output must be a subset of the solid output ---
+function subsetCheck(fn: string, args: string, solid: Position[], hollow: Position[]): void {
+  checked++;
+  const set: { [k: string]: boolean } = {};
+  for (const p of solid) set[key(p)] = true;
+  let outside = 0;
+  for (const p of hollow) if (!set[key(p)]) outside++;
+  if (outside) {
+    violations.push({ fn, args, kind: 'HOLLOW_NOT_SUBSET', detail: `${outside}/${hollow.length} hollow coords absent from solid` });
+  }
+}
