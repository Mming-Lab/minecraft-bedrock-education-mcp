{
  "name": "@mming-lab/minecraft-bedrock-education-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for controlling Minecraft Bedrock and Education Edition.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mming-Lab/minecraft-bedrock-education-mcp.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/Mming-Lab/minecraft-bedrock-education-mcp#readme",
  "bugs": {
    "url": "https://github.com/Mming-Lab/minecraft-bedrock-education-mcp/issues"
  },
  "keywords": [
    "minecraft",
    "bedrock",
    "websocket",
    "mcp",
    "model-context-protocol",
    "typescript",
    "claude",
    "ai",
    "automation",
    "gaming"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "socket-be": "^2.6.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "fast-check": "^4.9.0",
    "typescript": "5.9.3",
    "ws": "^8.21.3",
    "prismarine-nbt": "^2.8.0"
  },
  "bin": {
    "minecraft-bedrock-education-mcp": "./dist/index.js",
    "mcp-bridge-install": "./addon/install.mjs"
  },
  "files": [
    "dist",
    "addon"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p .",
    "test": "npm run build && node test/tools.test.mjs && node test/commands.test.mjs && node test/optimize.test.mjs && node test/placer.test.mjs && node test/build-layers.test.mjs && node test/world.test.mjs && node test/world-tools.test.mjs && node test/players.test.mjs && node test/bridge.test.mjs && node test/transport.test.mjs && node test/geometry.property.test.mjs && node test/server.test.mjs",
    "test:golden": "node ../../tools/golden-extract/validate.mjs --geometry ./test/golden-adapter.mjs --math ./test/golden-adapter.mjs --optimizer ./dist/commands/optimize.js",
    "start": "node dist/index.js"
  }
}
